---
// blogs.astro - Lists your Markdown blog entries
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

let posts = await getCollection('blog');
try {
	posts = await getCollection('blog');
} catch (e) {
	console.log("Syncing collection data...");
}
---

<Layout title="My Blog Posts | Portfolio">
	<div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; padding: 24px 0;">
		
		<section style="border-bottom: 1px solid #cbd5e1; padding-bottom: 16px;">
			<h1 style="font-size: 36px; font-weight: 800;">The Engineering Blog</h1>
			<p style="font-size: 18px; opacity: 0.8; margin-top: 4px;">
				Documenting my daily learning process, tech insights, and building steps.
			</p>
		</section>

		<div style="display: flex; flex-direction: column; gap: 24px;">
			{posts.length === 0 ? (
				<p style="opacity: 0.6; font-style: italic;">Syncing blog collection details...</p>
			) : (
				posts.map(post => (
					<article style="border: 1px solid rgba(148, 163, 184, 0.2); padding: 24px; border-radius: 8px; background-color: rgba(148, 163, 184, 0.03);">
						<button type="button" class="blog-more" data-more-target={`blog-more-${post.id}`} style="all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 10px; width: 100%;">
							<span style="font-size: 13px; opacity: 0.6;">
								{post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString() : ""}
							</span>
							<h2 style="font-size: 22px; font-weight: 700; margin: 0;">
								{post.data.title}
							</h2>
							<p style="opacity: 0.8; line-height: 1.5; margin: 0;">
								{post.data.description}
							</p>
							<span style="font-size: 13px; opacity: 0.7;">Tap for extra info ↓</span>
						</button>
						<div id={`blog-more-${post.id}`} class="blog-more-panel" hidden>
							<p style="opacity: 0.85; line-height: 1.6; margin: 14px 0 16px 0;">
								<strong>Extra:</strong> This article dives into key concepts, practical steps, and security-focused takeaways from my learning process.
							</p>
							<a href={`/blog/${post.id}`} style="color: #3B82F6; font-weight: 500; text-decoration: none;">
								Read Article →
							</a>
						</div>
					</article>
				))
			)}
		</div>

		<script is:inline>
			// Tap-to-expand extra info for blog cards
			for (const btn of document.querySelectorAll('.blog-more')) {
				btn.addEventListener('click', () => {
					const targetId = btn.getAttribute('data-more-target');
					const panel = document.getElementById(targetId);
					if (!panel) return;
					const isHidden = panel.hasAttribute('hidden');
					if (isHidden) panel.removeAttribute('hidden');
					else panel.setAttribute('hidden', '');
				});
			}
		</script>

	</div>
</Layout>