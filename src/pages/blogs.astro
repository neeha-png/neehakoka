---
// blogs.astro — Blog listing page.
// Fetches all Markdown posts from the 'blog' content collection and renders
// them as collapsible article cards. Prerendered to static HTML at build time.

export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Load all blog posts from src/content/blog/*.md
// Falls back to an empty array if the collection doesn't exist yet (safe for local dev)
let posts: any[] = [];
try {
	posts = await getCollection('blog');
} catch (e) {
	console.error('Failed to load blog collection:', e);
	posts = [];
}

// Strip the .md extension from post IDs to get clean URL-friendly slugs
const postsWithSlug = posts.map(post => ({
	...post,
	slug: post.id.replace(/\.md$/, ''),
}));
---

<Layout title="My Blog Posts | Portfolio" description="Engineering blog — documenting learning, tech insights, and build steps.">
	<div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; padding: 24px 0;">

		<!-- Page header: title and subtitle -->
		<section style="border-bottom: 1px solid #cbd5e1; padding-bottom: 16px;">
			<h1 style="font-size: 36px; font-weight: 800;">The Engineering Blog</h1>
			<p style="font-size: 18px; opacity: 0.8; margin-top: 4px;">
				Documenting my daily learning process, tech insights, and building steps.
			</p>
		</section>

		<!-- Post list: one card per blog post, collapsible via the toggle button -->
		<div style="display: flex; flex-direction: column; gap: 24px;">
			{postsWithSlug.length === 0 ? (
				<!-- Shown when the content collection is empty or failed to load -->
				<p style="opacity: 0.6; font-style: italic;">Syncing blog collection details...</p>
			) : (
				postsWithSlug.map(post => (
					<article style="border: 1px solid rgba(148, 163, 184, 0.2); padding: 24px; border-radius: 8px; background-color: rgba(148, 163, 184, 0.03);">
						<!-- Clickable button area: shows date, title, and description summary -->
						<button type="button" class="blog-more" data-more-target={`blog-more-${post.slug}`} style="all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 10px; width: 100%;">
							<span style="font-size: 13px; opacity: 0.6;">
								{post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : ""}
							</span>
							<div style="display:flex; align-items:flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
								<h2 style="font-size: 22px; font-weight: 700; margin: 0;">{post.data.title}</h2>
								<span style="font-size: 13px; opacity: 0.7; white-space: nowrap;">Tap for extra info ↓</span>
							</div>
							<p style="opacity: 0.8; line-height: 1.5; margin: 0;">{post.data.description}</p>
						</button>
						<!-- Expanded panel: shown after the toggle button is clicked -->
						<div id={`blog-more-${post.slug}`} class="blog-more-panel" hidden>
							<p style="opacity: 0.85; line-height: 1.6; margin: 14px 0 16px 0;">
								<strong>About this post:</strong> {post.data.description}
							</p>
							<!-- Link to the full rendered blog post page -->
							<a href={`/blog/${post.slug}`} style="color: #3B82F6; font-weight: 500; text-decoration: none;">
								Read Article →
							</a>
						</div>
					</article>
				))
			)}
		</div>

		<script is:inline>
			// Attach click listeners to all blog toggle buttons.
			// Clicking a button shows/hides the expanded description panel beneath it.
			for (const btn of document.querySelectorAll('.blog-more')) {
				btn.addEventListener('click', () => {
					const targetId = btn.getAttribute('data-more-target');
					const panel = document.getElementById(targetId);
					if (!panel) return;
					// Toggle the hidden attribute to show or hide the panel
					const isHidden = panel.hasAttribute('hidden');
					if (isHidden) panel.removeAttribute('hidden');
					else panel.setAttribute('hidden', '');
				});
			}
		</script>

	</div>
</Layout>
