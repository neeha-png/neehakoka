---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Me | Personal Portfolio">
  <main class="max-w-xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">Get in Touch</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Have a question or want to work together? Drop a message below, and I'll get back to you as soon as possible.
    </p>

    <form id="contact-form" class="space-y-6">
      <div>
        <label for="name" class="block text-sm font-medium mb-2">Name</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          required 
          minlength="2" 
          class="w-full p-3 border rounded-lg bg-transparent dark:border-gray-700"
          placeholder="Your name"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium mb-2">Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          class="w-full p-3 border rounded-lg bg-transparent dark:border-gray-700"
          placeholder="you@example.com"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium mb-2">Message</label>
        <textarea 
          id="message" 
          name="message" 
          required 
          minlength="10" 
          rows="5" 
          class="w-full p-3 border rounded-lg bg-transparent dark:border-gray-700"
          placeholder="Tell me about your project or inquiry (minimum 10 characters)..."
        ></textarea>
      </div>

      <button 
        type="submit" 
        id="submit-btn"
        class="w-full px-4 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50"
      >
        Send Message
      </button>
      
      <p id="form-status" class="mt-4 p-3 rounded-lg text-center font-medium hidden"></p>
    </form>
  </main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusMessage = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form && statusMessage && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Update UI state to loading
      submitBtn.disabled = true;
      statusMessage.classList.remove('hidden', 'bg-green-100', 'text-green-800', 'dark:bg-green-900/30', 'dark:text-green-400', 'bg-red-100', 'text-red-800', 'dark:bg-red-900/30', 'dark:text-red-400');
      statusMessage.textContent = 'Sending your message...';
      statusMessage.classList.add('block', 'bg-gray-100', 'text-gray-700', 'dark:bg-gray-800', 'dark:text-gray-300');

      // Collate form fields
      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        message: formData.get('message'),
      };

      try {
        // Post data directly to your newly built Cloudflare API route
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();
        statusMessage.classList.remove('bg-gray-100', 'text-gray-700', 'dark:bg-gray-800', 'dark:text-gray-300');

        if (response.ok) {
          // Success Feedback
          statusMessage.textContent = result.message || 'Success! Your message was sent.';
          statusMessage.classList.add('bg-green-100', 'text-green-800', 'dark:bg-green-900/30', 'dark:text-green-400');
          form.reset();
        } else {
          // Validation/Server Failure Feedback
          statusMessage.textContent = result.error || 'Something went wrong. Please check your details.';
          statusMessage.classList.add('bg-red-100', 'text-red-800', 'dark:bg-red-900/30', 'dark:text-red-400');
        }
      } catch (err) {
        // Network Disconnect Failure Feedback
        statusMessage.classList.remove('bg-gray-100', 'text-gray-700', 'dark:bg-gray-800', 'dark:text-gray-300');
        statusMessage.textContent = 'Network error. Could not reach the email server.';
        statusMessage.classList.add('bg-red-100', 'text-red-800', 'dark:bg-red-900/30', 'dark:text-red-400');
      } finally {
        // Re-enable button
        submitBtn.disabled = false;
      }
    });
  }
</script>