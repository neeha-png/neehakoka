---
// contact.astro — Dedicated contact page with a full-page form.
// Also accessible as an inline section on the homepage.
// Form data is submitted via fetch to /api/contact (server-side validation + D1 + Resend).
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Me | Personal Portfolio" description="Get in touch with Neeha Koka — drop a message and I will get back to you.">
  <main style="max-width: 850px; margin: 0 auto; padding: 80px 24px; color: #ffffff;">
    <h1 style="font-size: 36px; font-weight: 800; margin-bottom: 8px;">Get In Touch</h1>
    <p style="font-size: 16px; opacity: 0.8; margin-bottom: 32px;">
      Have a question or want to connect? Drop a message below!
    </p>

    <!-- Form card with subtle border and background -->
    <form id="contact-form" style="background-color: rgba(148, 163, 184, 0.03); border: 1px solid rgba(148, 163, 184, 0.1); border-radius: 12px; padding: 32px; display: flex; flex-direction: column; gap: 24px;">

      <!-- Full Name field -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label for="name" style="font-size: 14px; font-weight: 600; opacity: 0.9;">Full Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          minlength="2"
          placeholder="Your Name"
          style="width: 100%; background-color: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 6px; padding: 12px 16px; color: #ffffff; font-size: 14px; outline: none; box-sizing: border-box;"
        />
      </div>

      <!-- Email field -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label for="email" style="font-size: 14px; font-weight: 600; opacity: 0.9;">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="you@example.com"
          style="width: 100%; background-color: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 6px; padding: 12px 16px; color: #ffffff; font-size: 14px; outline: none; box-sizing: border-box;"
        />
      </div>

      <!-- Message textarea -->
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <label for="message" style="font-size: 14px; font-weight: 600; opacity: 0.9;">Message</label>
        <textarea
          id="message"
          name="message"
          required
          minlength="10"
          maxlength="2000"
          rows="5"
          placeholder="How can I help you?"
          style="width: 100%; background-color: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 6px; padding: 12px 16px; color: #ffffff; font-size: 14px; outline: none; resize: vertical; min-height: 120px; box-sizing: border-box;"
        ></textarea>
        <span id="message-counter" style="font-size: 12px; opacity: 0.6; align-self: flex-end;">0 / 2000</span>
      </div>

      <!-- Submit button -->
      <div>
        <button
          type="submit"
          id="submit-btn"
          style="background-color: #3B82F6; color: #ffffff; border: none; border-radius: 8px; padding: 12px 24px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background-color 0.2s; width: auto;"
          onmouseover="this.style.backgroundColor='#2563EB'"
          onmouseout="this.style.backgroundColor='#3B82F6'"
        >
          Send Message
        </button>
      </div>

      <!-- Status message: hidden by default, shown as green (success) or red (error) after submit -->
      <p id="form-status" style="margin-top: 16px; padding: 12px; border-radius: 8px; text-align: center; font-weight: 500; display: none;"></p>
    </form>
  </main>
</Layout>

<script>
  import { getCounterState } from '../lib/messageCounter';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusMessage = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement;
  const counter = document.getElementById('message-counter');

  function updateCounter() {
    if (!messageInput || !counter) return;
    const { text, isNearLimit } = getCounterState(messageInput.value.length);
    counter.textContent = text;
    counter.style.color = isNearLimit ? '#f87171' : '';
  }

  if (messageInput && counter) {
    updateCounter();
    messageInput.addEventListener('input', updateCounter);
  }

  if (form && statusMessage && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disable the button and show a loading state while the request is in flight
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.5';

      // Show a neutral "sending" indicator
      statusMessage.style.display = 'block';
      statusMessage.style.backgroundColor = 'rgba(148, 163, 184, 0.1)';
      statusMessage.style.color = '#ffffff';
      statusMessage.textContent = 'Sending your message...';

      // Collect form values into a plain object for JSON serialisation
      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        email: formData.get('email'),
        message: formData.get('message'),
      };

      try {
        // POST to the server-side API route that validates, saves to D1, and sends email
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json() as { message?: string; error?: string };

        if (response.ok) {
          // Success: show green banner and reset the form fields
          statusMessage.style.backgroundColor = 'rgba(34, 197, 94, 0.2)';
          statusMessage.style.color = '#4ade80';
          statusMessage.textContent = result.message || 'Success! Your message was sent.';
          form.reset();
          updateCounter();
        } else {
          // Server-side validation failure: show the API's error message in red
          statusMessage.style.backgroundColor = 'rgba(239, 68, 68, 0.2)';
          statusMessage.style.color = '#f87171';
          statusMessage.textContent = result.error || 'Something went wrong. Please check your details.';
        }
      } catch (err) {
        // Network failure: the fetch itself threw (offline, CORS, etc.)
        statusMessage.style.backgroundColor = 'rgba(239, 68, 68, 0.2)';
        statusMessage.style.color = '#f87171';
        statusMessage.textContent = 'Network error. Could not reach the email server.';
      } finally {
        // Always re-enable the button regardless of outcome
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });
  }
</script>
