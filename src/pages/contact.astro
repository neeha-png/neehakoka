---
// contact.astro - Contact Form Page
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Me | Portfolio">
	<div style="max-width: 600px; margin: 0 auto; padding: 24px 0; display: flex; flex-direction: column; gap: 24px;">
		
		<div>
			<h1 style="font-size: 36px; font-weight: 800; margin-bottom: 8px;">Get In Touch</h1>
			<p style="opacity: 0.8; line-height: 1.5;">
				Have a question, a project proposal, or just want to connect? Drop a message below and I will get back to you as soon as possible.
			</p>
		</div>

		<form style="display: flex; flex-direction: column; gap: 20px; background-color: rgba(148, 163, 184, 0.05); padding: 32px; border-radius: 12px; border: 1px solid rgba(148, 163, 184, 0.2);">
			
			<div style="display: flex; flex-direction: column; gap: 6px;">
				<label for="name" style="font-size: 14px; font-weight: 600;">Full Name</label>
				<input type="text" id="name" name="name" required placeholder="Your Name" style="padding: 10px; border-radius: 6px; border: 1px solid rgba(148, 163, 184, 0.4); background: transparent; color: inherit;" />
			</div>

			<div style="display: flex; flex-direction: column; gap: 6px;">
				<label for="email" style="font-size: 14px; font-weight: 600;">Email Address</label>
				<input type="email" id="email" name="email" required placeholder="you@example.com" style="padding: 10px; border-radius: 6px; border: 1px solid rgba(148, 163, 184, 0.4); background: transparent; color: inherit;" />
			</div>

			<div style="display: flex; flex-direction: column; gap: 6px;">
				<label for="message" style="font-size: 14px; font-weight: 600;">Message</label>
				<textarea id="message" name="message" rows="5" required placeholder="How can I help you?" style="padding: 10px; border-radius: 6px; border: 1px solid rgba(148, 163, 184, 0.4); background: transparent; color: inherit; font-family: inherit; resize: vertical;"></textarea>
			</div>

			<div>
				<button type="submit" style="background-color: #3B82F6; color: white; font-weight: 600; padding: 12px 24px; border: none; border-radius: 6px; cursor: pointer; transition: 0.2s;">
					Send Message
				</button>
			</div>

		</form>
	</div>
</Layout>