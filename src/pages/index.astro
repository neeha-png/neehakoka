		<!-- 3. WORKS / PROJECTS SECTION -->
		<section id="works" style="display: flex; flex-direction: column; gap: 24px; border-top: 1px solid rgba(148, 163, 184, 0.15); padding-top: 60px;">
			<h2 style="font-size: 32px; font-weight: 800; margin: 0;">Technical Project Showcases</h2>
			
			<!-- Project 1 (interactive) -->
			<div style="background-color: rgba(148, 163, 184, 0.02); border: 1px solid rgba(148, 163, 184, 0.1); border-radius: 12px; padding: 24px; display: flex; flex-direction: column; gap: 12px;">
				<button type="button" class="sp-project-more" data-more-target="index-project-flask" style="all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 8px; width: 100%;">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap;">
						<div>
							<span style="font-size: 12px; color: #3B82F6; font-weight: 700; text-transform: uppercase;">Flask & MySQL Stack</span>
							<h3 style="font-size: 22px; font-weight: 700; margin: 0;">Lost and Found in Campus Portal</h3>
						</div>
						<span style="font-size: 13px; opacity: 0.7; white-space: nowrap;">Tap for details ↓</span>
					</div>
					<p style="font-size: 15px; opacity: 0.8; line-height: 1.5; margin: 0;">
						Developed an audited multi-role item tracking application featuring user authentication, strict verification state workflows, and status tracking for 100+ active campus members.
					</p>
				</button>
				<div id="index-project-flask" class="sp-project-panel" hidden>
					<p style="font-size: 15px; opacity: 0.85; line-height: 1.6; margin-top: 10px;">
						<strong>The Challenge:</strong> Campus recovery systems often lack structural integrity, causing transparency issues when tracking down lost properties for hundreds of internal users.
					</p>
					<p style="font-size: 15px; opacity: 0.85; line-height: 1.6; margin-top: 8px;">
						<strong>The Engineering Approach:</strong> Developed a responsive multi-role Flask web application. Implemented strict state transitions for items (Unverified → Verified → Claimed Archived), integrated secure file-system directory access for image uploads, and established proof-based checking paths to secure handovers.
					</p>
					<p style="font-size: 15px; opacity: 0.85; line-height: 1.6; margin-top: 8px;">
						<strong>The Outcome:</strong> Built an audited data cycle serving over 100+ campus users with administrative visibility dashboards and automated email updates.
					</p>
				</div>
			</div>

			<!-- Project 2 (interactive) -->
			<div style="background-color: rgba(148, 163, 184, 0.02); border: 1px solid rgba(148, 163, 184, 0.1); border-radius: 12px; padding: 24px; display: flex; flex-direction: column; gap: 12px;">
				<button type="button" class="sp-project-more" data-more-target="index-project-django" style="all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 8px; width: 100%;">
					<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap;">
						<div>
							<span style="font-size: 12px; color: #3B82F6; font-weight: 700; text-transform: uppercase;">Python & Django Framework</span>
							<h3 style="font-size: 22px; font-weight: 700; margin: 0;">Academic Result Management System</h3>
						</div>
						<span style="font-size: 13px; opacity: 0.7; white-space: nowrap;">Tap for details ↓</span>
					</div>
					<p style="font-size: 15px; opacity: 0.8; line-height: 1.5; margin: 0;">
						Automated manual grading records into a secure full-stack layout featuring custom role boundaries for Administrators and Students to isolate grading views flawlessly.
					</p>
				</button>
				<div id="index-project-django" class="sp-project-panel" hidden>
					<p style="font-size: 15px; opacity: 0.85; line-height: 1.6; margin-top: 10px;">
						<strong>The Challenge:</strong> Manual institutional record-keeping introduces structural entry vulnerabilities and lack of controlled entry protocols for sensitive score summaries.
					</p>
					<p style="font-size: 15px; opacity: 0.85; line-height: 1.6; margin-top: 8px;">
						<strong>The Engineering Approach:</strong> Built a centralized full-stack MVC application leveraging Django's database toolkit. Engineered integrated operational panels for Profile, Course, and Result modules, and configured role-based authentication rules separating Administrators and Students.
					</p>
					<p style="font-size: 15px; opacity: 0.85; line-height: 1.6; margin-top: 8px;">
						<strong>The Outcome:</strong> Automated school data flows, boosting administrative speed while ensuring high record accuracy and isolated lookups.
					</p>
				</div>
			</div>
		</section>

		<!-- 3.5 BLOGS SECTION -->
		<section id="blogs" style="display: flex; flex-direction: column; gap: 24px; border-top: 1px solid rgba(148, 163, 184, 0.15); padding-top: 60px;">
			<h2 style="font-size: 32px; font-weight: 800; margin: 0;">The Engineering Blog</h2>
			<p style="font-size: 16px; opacity: 0.8; margin: 0;">Documenting my daily learning process, tech insights, and building steps.</p>
			
			<div style="display: flex; flex-direction: column; gap: 20px;">
				<!-- Article 1 (interactive) -->
				<div style="border: 1px solid rgba(148, 163, 184, 0.15); padding: 24px; border-radius: 8px; background-color: rgba(148, 163, 184, 0.01); display: flex; flex-direction: column; gap: 12px;">
					<button type="button" class="sp-blog-more" data-more-target="index-blog-portfolio" style="all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 8px; width: 100%;">
						<span style="font-size: 13px; opacity: 0.6;">May 29, 2026</span>
						<h3 style="font-size: 20px; font-weight: 700; margin: 0;">Kicking Off My Software Engineering Portfolio</h3>
						<p style="opacity: 0.8; line-height: 1.5; font-size: 15px; margin: 0;">
							An inside look into designing and architecting this portfolio site using Astro, layout structures, and clean CSS styling parameters.
						</p>
						<span style="font-size: 13px; opacity: 0.7; white-space: nowrap;">Tap for extra info ↓</span>
					</button>
					<div id="index-blog-portfolio" class="sp-blog-panel" hidden>
						<p style="font-size: 15px; opacity: 0.85; line-height: 1.6; margin-top: 10px;">
							<strong>What you'll learn:</strong> how I structured pages/layouts, handled styling consistently, and kept the UI responsive.
						</p>
						<a href="/blog/first-post" style="color: #3B82F6; font-weight: 600; text-decoration: none; margin-top: 8px; display: inline-block;">
							Read Article →
						</a>
						<a href="/blogs" style="display:none" aria-hidden="true">Back</a>
					</div>
				</div>

				<!-- Article 2 (interactive) -->
				<div style="border: 1px solid rgba(148, 163, 184, 0.15); padding: 24px; border-radius: 8px; background-color: rgba(148, 163, 184, 0.01); display: flex; flex-direction: column; gap: 12px;">
					<button type="button" class="sp-blog-more" data-more-target="index-blog-secure" style="all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 8px; width: 100%;">
						<span style="font-size: 13px; opacity: 0.6;">May 29, 2026</span>
						<h3 style="font-size: 20px; font-weight: 700; margin: 0;">Exploring Secure Systems Design</h3>
						<p style="opacity: 0.8; line-height: 1.5; font-size: 15px; margin: 0;">
							Breaking down the core network infrastructure principles, threat mitigation, and data transparency barriers I am studying for my CompTIA Security+ validation.
						</p>
						<span style="font-size: 13px; opacity: 0.7; white-space: nowrap;">Tap for extra info ↓</span>
					</button>
					<div id="index-blog-secure" class="sp-blog-panel" hidden>
						<p style="font-size: 15px; opacity: 0.85; line-height: 1.6; margin-top: 10px;">
							<strong>Focus areas:</strong> threat models, secure-by-design thinking, and practical ways to validate security controls.
						</p>
						<a href="/blog/learning-security" style="color: #3B82F6; font-weight: 600; text-decoration: none; margin-top: 8px; display: inline-block;">
							Read Article →
						</a>
						<a href="/blogs" style="display:none" aria-hidden="true">Back</a>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. CONTACT SECTION -->
<section id="contact" style="display: flex; flex-direction: column; gap: 24px; border-top: 1px solid rgba(148, 163, 184, 0.15); padding-top: 60px; padding-bottom: 40px;">
    <div>
        <h2 style="font-size: 32px; font-weight: 800; margin: 0;">Get In Touch</h2>
        <p style="opacity: 0.8; margin-top: 8px; margin-bottom: 0;">Have a question or want to connect? Drop a message below!</p>
    </div>
    
    <form id="sp-contact-form" style="display: flex; flex-direction: column; gap: 16px; background-color: rgba(148, 163, 184, 0.03); padding: 24px; border-radius: 12px; border: 1px solid rgba(148, 163, 184, 0.1);">
        <div style="display: flex; flex-direction: column; gap: 6px;">
            <label for="sp-name" style="font-size: 14px; font-weight: 600;">Full Name</label>
            <input type="text" id="sp-name" name="name" required minlength="2" placeholder="Your Name" style="padding: 10px; border-radius: 6px; border: 1px solid rgba(148, 163, 184, 0.3); background: transparent; color: inherit;" />
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px;">
            <label for="sp-email" style="font-size: 14px; font-weight: 600;">Email</label>
            <input type="email" id="sp-email" name="email" required placeholder="you@example.com" style="padding: 10px; border-radius: 6px; border: 1px solid rgba(148, 163, 184, 0.3); background: transparent; color: inherit;" />
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px;">
            <label for="sp-message" style="font-size: 14px; font-weight: 600;">Message</label>
            <textarea id="sp-message" name="message" rows="4" required minlength="10" placeholder="How can I help you?" style="padding: 10px; border-radius: 6px; border: 1px solid rgba(148, 163, 184, 0.3); background: transparent; color: inherit; font-family: inherit; resize: vertical;"></textarea>
        </div>
        <div>
            <button type="submit" id="sp-submit-btn" style="background-color: #3B82F6; color: white; font-weight: 600; padding: 12px 24px; border: none; border-radius: 6px; cursor: pointer;">
                Send Message
            </button>
        </div>
        <p id="sp-form-status" style="margin-top: 8px; padding: 12px; border-radius: 8px; text-align: center; font-weight: 500; display: none;"></p>
    </form>
</section>

	</div>
<script is:inline>
	// Project expand/collapse
	(() => {
		const buttons = document.querySelectorAll('.sp-project-more');
		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.getAttribute('data-more-target');
				if (!id) return;
				const panel = document.getElementById(id);
				if (!panel) return;
				panel.toggleAttribute('hidden');
			});
		});
	})();

	// Blog expand/collapse
	(() => {
		const buttons = document.querySelectorAll('.sp-blog-more');
		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.getAttribute('data-more-target');
				if (!id) return;
				const panel = document.getElementById(id);
				if (!panel) return;
				panel.toggleAttribute('hidden');
			});
		});
	})();
	// Contact form submission
(() => {
    const form = document.getElementById('sp-contact-form');
    const statusMessage = document.getElementById('sp-form-status');
    const submitBtn = document.getElementById('sp-submit-btn');

    if (form && statusMessage && submitBtn) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';

            statusMessage.style.display = 'block';
            statusMessage.style.backgroundColor = 'rgba(148, 163, 184, 0.1)';
            statusMessage.style.color = '#ffffff';
            statusMessage.textContent = 'Sending your message...';

            const formData = new FormData(form);
            const payload = {
                name: formData.get('name'),
                email: formData.get('email'),
                message: formData.get('message'),
            };

            try {
                const response = await fetch('/api/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });

                const result = await response.json();

                if (response.ok) {
                    statusMessage.style.backgroundColor = 'rgba(34, 197, 94, 0.2)';
                    statusMessage.style.color = '#4ade80';
                    statusMessage.textContent = result.message || 'Success! Your message was sent.';
                    form.reset();
                } else {
                    statusMessage.style.backgroundColor = 'rgba(239, 68, 68, 0.2)';
                    statusMessage.style.color = '#f87171';
                    statusMessage.textContent = result.error || 'Something went wrong. Please check your details.';
                }
            } catch (err) {
                statusMessage.style.backgroundColor = 'rgba(239, 68, 68, 0.2)';
                statusMessage.style.color = '#f87171';
                statusMessage.textContent = 'Network error. Could not reach the email server.';
            } finally {
                submitBtn.disabled = false;
                submitBtn.style.opacity = '1';
            }
        });
    }
})();
</script>

