    <!-- Flask Card (Dark Slate Theme) -->
    <div style="background-color: rgba(30, 41, 59, 0.4); border: 1px solid rgba(148, 163, 184, 0.1); border-radius: 12px; padding: 20px 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; transition: transform 0.2s, background-color 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.backgroundColor='rgba(30, 41, 59, 0.6)'" onmouseout="this.style.transform='translateY(0)'; this.style.backgroundColor='rgba(30, 41, 59, 0.4)'">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
