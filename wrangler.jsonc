{
  "compatibility_date": "2026-05-30",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "name": "personal-portfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION"
    }
  ],
  "observability": {
    "enabled": true
  }
}