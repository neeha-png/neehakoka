{
  "name": "neehakoka",
  "compatibility_date": "2024-04-03",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d8032b5c93a6440b9ba87dd957ee5f58"
    }
  ],
  "d1_databases": [
    {
      "binding": "portfolio_db",
      "database_name": "portfolio-db",
      "database_id": "3b8812a3-362f-419e-8a5e-9b9381186904"
    }
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "TO_EMAIL": "neehasm0@gmail.com"
  }
}