{
  "compatibility_date": "2026-05-30",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "name": "personal-portfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "5a87d1301c3644c5a37c0760e171a327" // 👈 Put your Cloudflare KV ID right here!
    }
  ],
  "observability": {
    "enabled": true
  }
}
